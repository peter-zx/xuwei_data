# ── 云端生产环境配置 ──────────────────────────────────────
APP_ENV=production
DEBUG=false

# ── 服务 ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8503
RELOAD=false
WORKERS=2

# ── 客户端连接地址（填写服务器实际 IP） ─────────────────
BASE_URL=http://122.51.231.239:8503

# ── 文件 ──────────────────────────────────────────────────
MAX_FILE_SIZE_MB=100
OUTPUT_DIR=storage/outputs

# ── 转换 ──────────────────────────────────────────────────
MAX_CONCURRENT_TASKS=4
TASK_TIMEOUT_SECONDS=300
